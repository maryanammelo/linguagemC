Nível 1 – Básico
Par ou Ímpar
Peça para o usuário digitar um número e diga se ele é par ou ímpar.
ex:
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <math.h>

int main(){
    int num;
    
    printf("Digite um numero e saiba se ele é par ou impar:\n");
    scanf("%d", &num);
    
    if(num % 2 == 0){
        printf("Esse numero é par.\n");
    } else {
        printf("Esse numero é impar. \n ");
    }
    return 0; 
}
