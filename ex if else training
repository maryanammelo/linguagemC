Solicite um número ao usuário e informe se ele é positivo, negativo ou zero.

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <math.h>

int main(){
    int num;
    printf("Digite um numero e saiba se ele é positivo negativo ou zero:\n");
    scanf("%d", &num);
    if(num > 0){
        printf("O numero é positivo.\n");
    } else if(num < 0){
        printf("O numero é negativo.\n");
    } else{
        printf("O numero é 0.\n ");
    }
    return 0;
}

