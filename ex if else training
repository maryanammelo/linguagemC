Maior de Idade

Peça a idade do usuário e informe se ele é maior de idade (18 anos ou mais) ou menor.
Número Positivo ou Negativo

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>
#include <math.h>

int main(){
    int idade;
    printf("Digite sua idade:\n");
    scanf("%d", &idade);
    
    if(idade >= 18){
        printf("Você é maior de idade.\n");
    } else{
        printf("Você é menor de idade.\n");
    }
    return 0;
}
