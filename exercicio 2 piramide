#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int main() {
	float vol, comp, larg, altura;
	
	printf("Digite um numero para ser o valor do comprimento da base da piramide: \n");
	scanf("%f", &comp);
	
	printf("Digite um numero para ser o valor da largura da base da piramide: \n");
	scanf("%f", &larg);
	
	printf("Digite um numero para ser o valor da altura da piramide: \n");
	scanf("%f", &altura);
	
	vol = (comp*larg*altura)/ 3;
	 
	printf("O valor do volume da piramide e: %f \n", vol);
	
	getchar();
	return 0;
}
