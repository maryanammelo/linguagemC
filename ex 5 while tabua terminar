#include <math.h>
#include <stdio.h>
#include <stdlib.h>

int main(){
    
    int n, tabuada;
    
    n=1;
    
    printf("Digite um numero, para que lhe seja fornecida a sua tabuada: \n ");
    scanf("%d", &n);
    
    while(n>0 && n>=1 && n<=10){
        
    
        n**=tabuada;
    }
    
    printf("%d", &tabuada);
    
    
    return 0;
}
