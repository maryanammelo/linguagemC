#include <stdlib.h>
#include <stdio.h>
#include <math.h>
#include <string.h>

int main(){
    char login[20], senha[20], verlogin[20], versenha[20];
    
    printf("Para realizar o cadastro digite seu nome:\n");
    scanf("%s", &login);
    
    printf("Digite sua senha:\n");
    scanf("%s", &senha);
    
    printf("\t Cadastro realizado com sucesso! \n");
    
    printf("Digite seu login: \n");
    scanf("%s", &verlogin);
    
    printf("Digite sua senha: \n");
    scanf("%s", &versenha);
     
    printf("Seu login foi realizado com sucesso! \n");
    
    if((strcmp(login, verlogin) == 0) && (strcmp(senha, versenha)== 0)){
        printf("Seja Bem vindo :) \n");
    }
    else{
        printf("Nao foi possivel realizar o login :( \n");
    }
    
    getchar();
    return 0;
}
